#!/usr/bin/env sh
# commit-msg hook: enforce Conventional Commits format
# Pattern: type(scope): description
# Example: feat(auth): add login page tests

MSG=$(cat "$1")
PATTERN="^(feat|fix|test|refactor|chore|docs|style|ci|perf|build|revert)(\([a-z0-9-]+\))?: .{1,100}"

if ! echo "$MSG" | grep -qE "$PATTERN"; then
  echo ""
  echo "❌ Invalid commit message format."
  echo ""
  echo "   Your message: $MSG"
  echo ""
  echo "   Required format: type(scope): description"
  echo "   Examples:"
  echo "     feat(auth): add login page tests"
  echo "     test(api): validate find transactions response"
  echo "     fix(billpay): correct payee field selector"
  echo ""
  echo "   Allowed types: feat | fix | test | refactor | chore | docs | style | ci | perf | build | revert"
  echo ""
  exit 1
fi
